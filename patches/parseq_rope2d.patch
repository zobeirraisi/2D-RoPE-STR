+class RotaryEmbedding2D(nn.Module):
+    """Axial 2D-RoPE as in the 2D-RoPE-STR main model: equal row/column split of the
+    head dimension, base 10000, and learnable per-axis frequency scales (beta)."""
+
+    def __init__(self, head_dim: int, base: float = 10000.0):
+        super().__init__()
+        self.d_h = head_dim // 2
+        self.d_w = head_dim - self.d_h
+        inv = lambda d: 1.0 / (base ** (torch.arange(0, d, 2).float() / d))  # noqa: E731
+        self.register_buffer('inv_freq_h', inv(self.d_h), persistent=False)
+        self.register_buffer('inv_freq_w', inv(self.d_w), persistent=False)
+        self.beta_h = nn.Parameter(torch.ones(1))
+        self.beta_w = nn.Parameter(torch.ones(1))
+
+    def forward(self, H: int, W: int, device):
+        h = torch.arange(H, device=device).float() * self.beta_h.float()
+        w = torch.arange(W, device=device).float() * self.beta_w.float()
+        hf = torch.outer(h, self.inv_freq_h)  # (H, d_h/2)
+        wf = torch.outer(w, self.inv_freq_w)  # (W, d_w/2)
+        return torch.polar(torch.ones_like(hf), hf), torch.polar(torch.ones_like(wf), wf)
+
+
+def apply_2d_rope(x: Tensor, hf: Tensor, wf: Tensor, H: int, W: int, d_h: int) -> Tensor:
+    """x: (B, heads, H*W, head_dim), tokens in row-major order."""
+    B, nh, N, D = x.shape
+    x = x.float().view(B, nh, H, W, D)
+    xh = torch.view_as_complex(x[..., :d_h].reshape(B, nh, H, W, -1, 2))
+    xw = torch.view_as_complex(x[..., d_h:].reshape(B, nh, H, W, -1, 2))
+    xh = torch.view_as_real(xh * hf[None, None, :, None]).flatten(-2)
+    xw = torch.view_as_real(xw * wf[None, None, None, :]).flatten(-2)
+    return torch.cat([xh, xw], dim=-1).view(B, nh, N, D)
+
+
+class RoPEAttention(nn.Module):
+    """timm ViT attention with 2D-RoPE applied to queries and keys (same weights layout)."""
+
+    def __init__(self, attn: nn.Module):
+        super().__init__()
+        self.num_heads, self.head_dim = attn.num_heads, attn.head_dim
+        self.qkv, self.q_norm, self.k_norm = attn.qkv, attn.q_norm, attn.k_norm
+        self.attn_drop, self.proj, self.proj_drop = attn.attn_drop, attn.proj, attn.proj_drop
+
+    def forward(self, x: Tensor, hf: Tensor, wf: Tensor, H: int, W: int, d_h: int) -> Tensor:
+        B, N, C = x.shape
+        qkv = self.qkv(x).reshape(B, N, 3, self.num_heads, self.head_dim).permute(2, 0, 3, 1, 4)
+        q, k, v = qkv.unbind(0)
+        q, k = self.q_norm(q), self.k_norm(k)
+        q = apply_2d_rope(q, hf, wf, H, W, d_h).type_as(v)
+        k = apply_2d_rope(k, hf, wf, H, W, d_h).type_as(v)
+        x = F.scaled_dot_product_attention(q, k, v, dropout_p=self.attn_drop.p if self.training else 0.0)
+        x = x.transpose(1, 2).reshape(B, N, C)
+        return self.proj_drop(self.proj(x))
+
+
 class Encoder(VisionTransformer):
 
     def __init__(
@@ -141,6 +195,7 @@ class Encoder(VisionTransformer):
         attn_drop_rate=0.0,
         drop_path_rate=0.0,
         embed_layer=PatchEmbed,
+        pos_enc='learned',
     ):
         super().__init__(
             img_size,
@@ -159,6 +214,27 @@ class Encoder(VisionTransformer):
             global_pool='',  # disable the
             class_token=False,  # classifier head.
         )
+        if pos_enc not in ('learned', 'rope2d'):
+            raise ValueError(f'unknown pos_enc: {pos_enc}')
+        self.pos_enc = pos_enc
+        if pos_enc == 'rope2d':
+            # Replace the learned additive position embedding by 2D-RoPE in every encoder block.
+            self.pos_embed = None
+            self.rope = RotaryEmbedding2D(embed_dim // num_heads)
+            for blk in self.blocks:
+                blk.attn = RoPEAttention(blk.attn)
+
+    def forward_features(self, x):
+        if self.pos_enc == 'learned':
+            return super().forward_features(x)
+        x = self.patch_embed(x)  # (B, H*W, C), row-major
+        x = self.norm_pre(self.patch_drop(self.pos_drop(x)))
+        H, W = self.patch_embed.grid_size
+        hf, wf = self.rope(H, W, x.device)
+        for blk in self.blocks:
+            x = x + blk.drop_path1(blk.ls1(blk.attn(blk.norm1(x), hf, wf, H, W, self.rope.d_h)))
+            x = x + blk.drop_path2(blk.ls2(blk.mlp(blk.norm2(x))))
+        return self.norm(x)
 
     def forward(self, x):
         # Return all tokens

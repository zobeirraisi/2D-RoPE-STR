+#!/usr/bin/env python3
+"""Evaluate a PARSeq checkpoint with the protocol of test.py (36-char, case-insensitive)
+and write the word accuracies as JSON in the 2D-RoPE-STR results format:
+
+    {"1015_2077": {"IIIT5K": .., "SVT": .., "IC13": .., "IC15": .., "CUTE80": .., "SVTP": .., "Avg": ..},
+     "857_1811":  {...}, "n": {dataset: num_samples}, ...}
+
+Avg is the unweighted mean of the six benchmarks.
+"""
+import argparse
+import json
+import os
+import string
+
+import torch
+from tqdm import tqdm
+
+from strhub.data.module import SceneTextDataModule
+from strhub.models.utils import load_from_checkpoint
+
+NAMES = {'IIIT5k': 'IIIT5K', 'SVT': 'SVT', 'IC13_857': 'IC13', 'IC13_1015': 'IC13',
+         'IC15_1811': 'IC15', 'IC15_2077': 'IC15', 'CUTE80': 'CUTE80', 'SVTP': 'SVTP'}
+ORDER = ['IIIT5K', 'SVT', 'IC13', 'IC15', 'CUTE80', 'SVTP']
+
+
+@torch.inference_mode()
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('checkpoint')
+    ap.add_argument('--out', required=True)
+    ap.add_argument('--data_root', default='data')
+    ap.add_argument('--batch_size', type=int, default=512)
+    ap.add_argument('--num_workers', type=int, default=4)
+    ap.add_argument('--device', default='cuda')
+    args = ap.parse_args()
+
+    charset_test = string.digits + string.ascii_lowercase
+    model = load_from_checkpoint(args.checkpoint, charset_test=charset_test).eval().to(args.device)
+    hp = model.hparams
+    dm = SceneTextDataModule(args.data_root, '_unused_', hp.img_size, hp.max_label_length, hp.charset_train,
+                             hp.charset_test, args.batch_size, args.num_workers, False)
+    test_set = sorted(set(SceneTextDataModule.TEST_BENCHMARK_SUB + SceneTextDataModule.TEST_BENCHMARK))
+    acc, n = {}, {}
+    for name, dl in dm.test_dataloaders(test_set).items():
+        total = correct = 0
+        for imgs, labels in tqdm(iter(dl), desc=name):
+            res = model.test_step((imgs.to(model.device), labels), -1)['output']
+            total += res.num_samples
+            correct += res.correct
+        acc[name], n[name] = 100.0 * correct / total, total
+
+    out = {'checkpoint': os.path.abspath(args.checkpoint), 'pos_enc': hp.get('pos_enc', 'learned'), 'n': n}
+    for proto, sets in (('1015_2077', SceneTextDataModule.TEST_BENCHMARK),
+                        ('857_1811', SceneTextDataModule.TEST_BENCHMARK_SUB)):
+        r = {NAMES[s]: acc[s] for s in sets}
+        r = {k: r[k] for k in ORDER}
+        r['Avg'] = sum(r.values()) / len(ORDER)
+        out[proto] = r
+        print(proto, '  '.join(f'{k} {v:.2f}' for k, v in r.items()))
+    tmp = args.out + '.tmp'
+    with open(tmp, 'w') as f:
+        json.dump(out, f, indent=2)
+    os.replace(tmp, args.out)
+    print('wrote', args.out)
+
+
+if __name__ == '__main__':
+    main()
